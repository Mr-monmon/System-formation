---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, dir, path, locales, defaultLocale, type Locale, type RouteKey } from '../i18n';
import { buildGraph } from '../seo/schema';
import '../styles/global.css';

interface Props {
  lang: Locale;
  route: RouteKey;
  title: string;
  description: string;
  /** Home uses a dark hero, so the page starts flush under the header. */
  flush?: boolean;
  /** Error pages: kept out of the index, with no canonical or alternates. */
  noindex?: boolean;
}
const { lang, route, title, description, flush = false, noindex = false } = Astro.props;
const copy = t(lang);
const site = Astro.site ?? new URL('https://tashkeeltech.com');
const canonical = new URL(path(lang, route), site).href;
// The brand kit ships one bilingual card (EN wordmark, EN + AR taglines).
const ogImage = new URL('/og/og-image.png', site).href;
const direction = dir(lang);

// Cloudflare Web Analytics: cookieless, no personal data, and only present when
// the site token is set at build time (DEPLOY.md §2). The token is public by
// design. `spa` counts ClientRouter navigations as page views.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
const analyticsBeacon = analyticsToken ? JSON.stringify({ token: analyticsToken, spa: true }) : null;

const graph = buildGraph({ lang, route, title, description, site, noindex });

---

<!doctype html>
<html lang={copy.meta.htmlLang} dir={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <link rel="canonical" href={canonical} />
        {locales.map((l) => (
          <link rel="alternate" hreflang={l === 'ar' ? 'ar-SA' : 'en'} href={new URL(path(l, route), site).href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(path(defaultLocale, route), site).href} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.meta.siteName} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_GB' : 'ar_SA'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${copy.meta.siteName} — ${copy.meta.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#081522" />
    <link rel="icon" href="/brand/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/icons/favicon.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Cairo: one variable file per script. Arabic pages need both (Latin
         carries figures and terms like SIEM); English pages only Latin above
         the fold. -->
    {lang === 'ar' && <link rel="preload" as="font" type="font/woff2" href="/fonts/cairo-arabic-var.woff2" crossorigin />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cairo-latin-var.woff2" crossorigin />

    <script is:inline>
      // Set before first paint so entrance animations never flash their start state
      // on machines that ask for reduced motion, and so no-JS users see finished copy.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('reduced-motion');
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <ClientRouter />
    {analyticsBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={analyticsBeacon}
      ></script>
    )}
  </head>

  <body class={flush ? 'is-flush' : ''}>
    <a class="skip-link" href="#main">{copy.common.skipToContent}</a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- The band wipe that plays between routes. -->
    <div class="route-wipe" aria-hidden="true" data-wipe>
      <span class="route-wipe__band route-wipe__band--navy"></span>
      <span class="route-wipe__band route-wipe__band--blue"></span>
    </div>

    <script>
      import { initMotion } from '../scripts/motion';
      // astro:page-load fires on the initial load as well as after every
      // client-side navigation, so this is the only call needed.
      document.addEventListener('astro:page-load', () => initMotion());
    </script>

    <style is:global>
      body {
        min-block-size: 100svh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
      }
      main:focus {
        outline: none;
      }

      /* ---- Route transition: two bands sweep across, then lift ---- */
      .route-wipe {
        position: fixed;
        inset: 0;
        z-index: 90;
        pointer-events: none;
        display: grid;
      }
      .route-wipe__band {
        grid-area: 1 / 1;
        display: block;
        transform: scaleX(0);
        transform-origin: inline-start;
      }
      /* Flat, like the brand: a navy band trailed by a neon one. */
      .route-wipe__band--navy {
        background: var(--tk-navy-2);
      }
      .route-wipe__band--blue {
        background: var(--tk-neon);
      }
      html.is-wiping .route-wipe__band {
        animation: wipe-in 620ms var(--ease-expo) forwards;
      }
      html.is-wiping .route-wipe__band--navy {
        animation-delay: 60ms;
      }
      @keyframes wipe-in {
        0% {
          transform: scaleX(0);
        }
        45% {
          transform: scaleX(1);
        }
        55% {
          transform: scaleX(1);
          transform-origin: inline-end;
        }
        100% {
          transform: scaleX(0);
          transform-origin: inline-end;
        }
      }

      /* Astro's own cross-document fade is replaced by the band wipe. */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 320ms;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
      }

      @media (prefers-reduced-motion: reduce) {
        .route-wipe {
          display: none;
        }
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </body>
</html>
