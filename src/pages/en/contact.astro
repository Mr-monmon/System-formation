---
import Base from '../../layouts/Base.astro';
import ContactPage from '../../components/pages/ContactPage.astro';
import { t } from '../../i18n';

const lang = 'en' as const;
const copy = t(lang);
---

<Base lang={lang} route="contact" title={copy.contact.seo.title} description={copy.contact.seo.description}>
  <ContactPage lang={lang} />
</Base>
