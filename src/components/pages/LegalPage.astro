---
import Slide from '../ui/Slide.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  doc: 'privacy' | 'terms';
}
const { lang, doc } = Astro.props;
const copy = t(lang);
const page = copy[doc];
/** Bumped by hand whenever the text changes; shown so visitors can date it. */
const updated = '2026-09-27';
const formatted = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-SA-u-nu-latn-ca-gregory' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(updated));
---

<Slide tone="light">
  <article class="legal">
    <h1>{page.h1}</h1>
    <p class="legal__updated">{page.updated}: <time datetime={updated}>{formatted}</time></p>

    {page.sections.map((section) => (
      <section class="legal__section">
        <h2>{section.h}</h2>
        {section.p.map((para) => <p>{para}</p>)}
      </section>
    ))}
  </article>
</Slide>

<style>
  .legal { max-inline-size: 46rem; }
  .legal h1 { font-size: var(--fs-h1); }
  .legal__updated {
    margin-block-start: var(--sp-5);
    font-size: var(--fs-meta);
    color: var(--text-faint);
  }
  .legal__section { margin-block-start: var(--sp-7); }
  .legal__section h2 { font-size: var(--fs-h3); }
  .legal__section p { margin-block-start: var(--sp-4); color: var(--text-muted); }
</style>
