---
import Slide from '../ui/Slide.astro';
import StructureGrid from '../ui/StructureGrid.astro';
import { t, path, type Locale } from '../../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const copy = t(lang);
const n = copy.notFound;
---

<Slide tone="dark" tall class="nf">
  <StructureGrid rows={5} cols={12} />
  <div class="nf__inner">
    <p class="nf__code lat" aria-hidden="true">{n.code}</p>
    <h1>{n.h1}</h1>
    <p class="lead">{n.body}</p>
    <div class="nf__actions">
      <a class="btn btn--primary" href={path(lang, 'home')}>{n.home}</a>
      <a class="btn btn--ghost" href={path(lang, 'contact')}>{n.contact}</a>
    </div>
  </div>
</Slide>

<style>
  .nf__inner { position: relative; z-index: 1; }
  .nf__code {
    font-size: clamp(4rem, 3rem + 8vw, 9rem);
    font-weight: var(--fw-black);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sf-blue-300);
    opacity: 0.35;
  }
  .nf h1 { margin-block-start: var(--sp-4); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-block-start: var(--sp-6); }
</style>
