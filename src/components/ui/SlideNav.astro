---
/** Slim progress rail on the inline-end edge; mirrored automatically in RTL. */
interface Props {
  items: { id: string; label: string }[];
  navLabel: string;
  goLabel: string;
}
const { items, navLabel, goLabel } = Astro.props;
---

<nav class="slidenav" aria-label={navLabel} data-slidenav>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} aria-current="false">
            <span class="slidenav__dot" aria-hidden="true" />
            <span class="slidenav__tip">{item.label}</span>
            <span class="visually-hidden">{goLabel}: {item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .slidenav {
    position: fixed;
    inset-inline-end: clamp(0.5rem, 1.6vw, 1.5rem);
    inset-block-start: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
  }
  @media (min-width: 1100px) {
    .slidenav {
      display: block;
    }
  }
  .slidenav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .slidenav a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0.35rem;
    text-decoration: none;
  }
  .slidenav__dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    /* The rail floats over light and dark sections alike, so the resting
       colour has to work on both. */
    background: rgba(125, 138, 158, 0.55);
    transition:
      background-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  /* The rail floats over navy and light sections alike: a neon fill with a
     navy ring reads on both (neon alone vanishes on light). */
  .slidenav a[aria-current='true'] .slidenav__dot {
    background: var(--tk-neon);
    box-shadow: 0 0 0 1.5px var(--tk-navy);
    transform: scale(1.6);
  }
  /* Absolutely positioned: a hidden label must not push the dot around. */
  .slidenav__tip {
    position: absolute;
    inset-inline-end: calc(100% + 0.5rem);
    inset-block-start: 50%;
    margin-block-start: -1em;
    max-inline-size: 15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--fs-meta);
    color: var(--tk-mist);
    background: rgba(20, 38, 58, 0.96);
    border: 1px solid var(--tk-border-on-dark);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
    opacity: 0;
    transform: translateX(6px);
    pointer-events: none;
    white-space: nowrap;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  :global([dir='rtl']) .slidenav__tip {
    transform: translateX(-6px);
  }
  .slidenav a:hover .slidenav__tip,
  .slidenav a:focus-visible .slidenav__tip {
    opacity: 1;
    transform: none;
  }
</style>
