---
/**
 * Official tashkeel tech lockups, served as-is from public/brand/logo/.
 *
 * <img> rather than inline: the lockups carry their wordmarks as outlined
 * paths (17–73 KB each), so referencing them lets the browser cache one file
 * instead of every page repeating the markup.
 *
 * Placement follows the brand kit:
 *   header — the primary English lockup on both languages, as the kit's own
 *            website mockup shows;
 *   footer — the Arabic lockup on /ar/, where the brand is shown in Arabic
 *            beside the Arabic legal name, and the English lockup on /en/.
 *
 * The lockup files include their own clear space, and the header size keeps
 * the artwork above the kit's 120px minimum width.
 */
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  variant?: 'header' | 'footer';
  /** Pick the on-light file when the logo sits on a light surface. */
  surface?: 'dark' | 'light';
  class?: string;
}

const { lang, variant = 'header', surface = 'dark', class: className = '' } = Astro.props;
const copy = t(lang);

const arabicFooter = variant === 'footer' && lang === 'ar';
const file = arabicFooter ? `lockup-ar-on-${surface}.svg` : `lockup-en-on-${surface}.svg`;
const box = arabicFooter ? { width: 512, height: 198 } : { width: 668, height: 253 };
const alt = arabicFooter ? copy.meta.logoAltAr : copy.meta.logoAlt;
---

<img
  class={`logo logo--${variant} ${className}`}
  src={`/brand/logo/${file}`}
  width={box.width}
  height={box.height}
  alt={alt}
  decoding="async"
  fetchpriority={variant === 'header' ? 'high' : 'auto'}
  loading={variant === 'header' ? 'eager' : 'lazy'}
/>

<style>
  .logo {
    display: block;
    block-size: auto;
    max-inline-size: none;
  }
  /* 150px keeps the artwork (the file carries ~7% padding a side) above the
     kit's 120px minimum for the horizontal lockup. */
  .logo--header {
    inline-size: 150px;
  }
  .logo--footer {
    inline-size: 190px;
  }
</style>
