---
/**
 * The tashkeel tech mark, inlined from the official brand kit
 * (brand/tashkeel/logo/svg/mark-*.svg).
 *
 * The geometry below is copied verbatim. The three official files differ only
 * in colour, so `tone` picks one of exactly those three values — it is the
 * official neon / navy / white variant, not a recolour. The brand rules forbid
 * redrawing, rotating, stretching, gradients, shadows and glows; nothing here
 * does any of those.
 *
 * Inline rather than <img> so the hero can animate the seven parts (four bars
 * and the three hexagonal ش dots) into place. The animation only ever
 * translates and fades them, and ends on the exact official artwork.
 *
 * `simplified` renders the favicon construction — no dots — which the kit
 * requires below 32px.
 */
interface Props {
  tone?: 'neon' | 'navy' | 'white';
  /** Leave blank for decorative use; the parent supplies the accessible name. */
  title?: string;
  simplified?: boolean;
  class?: string;
}

const { tone = 'neon', title, simplified = false, class: className = '' } = Astro.props;

const COLOURS = { neon: '#CCFF00', navy: '#081522', white: '#FFFFFF' } as const;
const colour = COLOURS[tone];

const BARS = [
  '24.0,54.0 128.0,28.0 128.0,50.0 24.0,76.0',
  '24.0,94.0 46.0,88.5 46.0,115.6 70.0,135.1 70.0,163.5 24.0,126.0',
  '88.0,78.0 112.0,72.0 112.0,177.3 100.0,188.0 88.0,178.2',
  '154.0,84.0 176.0,78.5 176.0,120.0 130.0,161.2 130.0,131.6 154.0,110.2',
];
const DOTS = [
  '138.0,63.0 142.3,65.5 142.3,70.5 138.0,73.0 133.7,70.5 133.7,65.5',
  '154.0,54.0 158.3,56.5 158.3,61.5 154.0,64.0 149.7,61.5 149.7,56.5',
  '170.0,45.0 174.3,47.5 174.3,52.5 170.0,55.0 165.7,52.5 165.7,47.5',
];
---

<svg
  class={`tk-mark ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 161 169"
  width="161"
  height="169"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title || undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  <g transform="translate(-19.50,-15.50) scale(1.0000)">
    <g transform="translate(0,-8)" fill={colour} stroke={colour} stroke-width="9" stroke-linejoin="round">
      {BARS.map((points, i) => <polygon points={points} data-mark-part="bar" data-index={i} />)}
      {!simplified && DOTS.map((points, i) => (
        <polygon points={points} stroke-width="5" data-mark-part="dot" data-index={i} />
      ))}
    </g>
  </g>
</svg>

<style>
  /* :where() keeps specificity at zero; a parent sizes the mark through the
     inherited --mark-block / --mark-inline properties, because Astro's style
     scoping stops a parent's class rule reaching this element. */
  :where(.tk-mark) {
    inline-size: var(--mark-inline, auto);
    block-size: var(--mark-block, 1em);
    overflow: visible;
  }
</style>
