---
/**
 * The "formation" motif: a faint hexagonal lattice that assembles as the
 * section scrolls into view. Decorative only, and quiet by design.
 */
interface Props {
  rows?: number;
  cols?: number;
  class?: string;
}
const { rows = 12, cols = 22, class: className = '' } = Astro.props;

const W = 34;
const H = 30;
// A complete, connected honeycomb. The "assembling" is the animation — at rest
// this has to read as one continuous structure, not a scatter of fragments.
const cells: { x: number; y: number }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    cells.push({ x: c * (W * 0.75), y: r * H + (c % 2 ? H / 2 : 0) });
  }
}
const hex = (cx: number, cy: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 180) * (60 * i);
    return `${(cx + (W / 2) * Math.cos(a)).toFixed(2)},${(cy + (H / 2) * Math.sin(a)).toFixed(2)}`;
  }).join(' ');
---

<svg
  class={`structure ${className}`}
  viewBox={`0 0 ${cols * W * 0.75} ${rows * H + H / 2}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  data-structure
>
  <g class="structure__cells" data-cells>
    {cells.map((cell) => (
      <polygon data-cell points={hex(cell.x + W / 2, cell.y + H / 2)} vector-effect="non-scaling-stroke" />
    ))}
  </g>
</svg>

<style>
  .structure {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    z-index: 0;
  }
  /* The faint level lives on the group, because the assemble animation drives
     each polygon's own opacity from 0 to 1 and would otherwise overwrite it.
     Hexagons echo the mark's own ش dots. Neon on dark, navy on light (neon is
     never a line on a light surface). */
  .structure__cells {
    opacity: 0.05;
  }
  /* non-scaling-stroke keeps these at a hairline however far the slice scales,
     which is what stops the motif shouting over the headline. */
  .structure polygon {
    fill: none;
    stroke: var(--lattice);
    stroke-width: 1;
  }
</style>
