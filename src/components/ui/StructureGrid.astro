---
/**
 * The "formation" motif: a faint hexagonal lattice that assembles as the
 * section scrolls into view. Decorative only, and quiet by design.
 */
interface Props {
  rows?: number;
  cols?: number;
  class?: string;
}
const { rows = 5, cols = 12, class: className = '' } = Astro.props;

const W = 34;
const H = 30;
const cells: { x: number; y: number; o: number }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    cells.push({
      x: c * (W * 0.75),
      y: r * H + (c % 2 ? H / 2 : 0),
      // A deterministic scatter keeps the build reproducible.
      o: 0.25 + (((r * 7 + c * 13) % 9) / 9) * 0.75,
    });
  }
}
const hex = (cx: number, cy: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 180) * (60 * i);
    return `${(cx + (W / 2) * Math.cos(a)).toFixed(2)},${(cy + (H / 2) * Math.sin(a)).toFixed(2)}`;
  }).join(' ');
---

<svg
  class={`structure ${className}`}
  viewBox={`0 0 ${cols * W * 0.75} ${rows * H + H / 2}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  data-structure
>
  {cells.map((cell) => (
    <polygon data-cell points={hex(cell.x + W / 2, cell.y + H / 2)} opacity={cell.o} />
  ))}
</svg>

<style>
  .structure {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .structure polygon {
    fill: none;
    stroke: var(--sf-blue-300);
    stroke-width: 0.6;
    opacity: 0.18;
  }
  :global(.slide--dark) .structure polygon {
    stroke: var(--sf-blue-300);
  }
</style>
