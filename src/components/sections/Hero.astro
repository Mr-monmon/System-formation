---
import Mark from '../ui/Mark.astro';
import StructureGrid from '../ui/StructureGrid.astro';
import { t, path, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const copy = t(lang);
const hero = copy.home.hero;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <StructureGrid class="hero__grid" rows={11} cols={19} />
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__mask">
        <h1 id="hero-title" data-hero-line>{hero.h1}</h1>
      </span>
      <p class="lead hero__sub" data-hero-fade>{hero.sub}</p>
      <div class="hero__ctas" data-hero-fade>
        <a class="btn btn--primary" href={path(lang, 'partner')}>{hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href="#savings">{hero.ctaSecondary}</a>
      </div>
    </div>

    <!-- The mark assembles here: four bars converge into the shield, then the
         three ش dots arrive. Flat neon, no shadow or glow — brand rules. -->
    <div class="hero__markwrap" data-hero-mark>
      <Mark tone="neon" class="hero__mark" title={hero.markAlt} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    padding-block: clamp(var(--sp-8), 10vh, var(--sp-10));
    /* Reserved height, so swapping in the webfont cannot reflow the section
       once it arrives. */
    min-block-size: 78svh;
    display: grid;
    align-content: center;
  }
  @media (min-width: 900px) {
    .hero {
      min-block-size: min(92vh, 56rem);
    }
  }
  .hero__grid {
    opacity: 0.9;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--sp-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.35fr 1fr;
      gap: var(--sp-9);
    }
  }
  .hero__mask {
    display: block;
    overflow: hidden;
    padding-block-end: 0.12em;
  }
  .hero h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--text);
    max-inline-size: 16ch;
  }
  :global([lang='ar']) .hero h1 {
    max-inline-size: 17ch;
  }
  .hero__sub {
    margin-block-start: var(--sp-5);
    color: var(--text-muted);
    max-inline-size: 54ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-block-start: var(--sp-6);
  }
  /* The kit asks for clear space of at least the central stem's width
     (~12% of the mark) on every side; the padding keeps it. */
  .hero__markwrap {
    --mark-inline: 100%;
    --mark-block: auto;
    justify-self: center;
    inline-size: min(100%, 17rem);
    padding: 12%;
  }
  @media (max-width: 899px) {
    .hero__markwrap {
      order: -1;
      inline-size: min(44%, 10rem);
      justify-self: start;
      padding: 0;
    }
  }
</style>
